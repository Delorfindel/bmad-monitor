# One deployment monitors exactly one project. Copy this file to `.env` for
# local work; on Vercel, set the same variables in Project Settings.

# --- GitHub mode (production) ------------------------------------------------
# Repository to read, as "owner/name".
BMAD_REPOSITORY=acme/atlas-portal

# Branch, tag or commit SHA. Resolved to a commit SHA once per build so the
# whole site is generated from a single, consistent snapshot.
BMAD_REF=main

# The sprint-status.yaml that defines this deployment's scope. It is the only
# authority on which epics and stories are published.
BMAD_SPRINT_STATUS=_bmad-output/implementation-artifacts/sprint-6/sprint-status.yaml

# Fine-grained personal access token with ONLY "Contents: Read-only" on the
# repository above. Read at build time; never sent to the browser.
# Never prefix it with VITE_ or any other client-exposed prefix.
GITHUB_TOKEN=github_pat_replace_me

# Optional. Defaults to https://api.github.com.
# GITHUB_API_URL=https://api.github.com

# --- Fixture mode (local development, no token needed) -----------------------
# When set, GitHub is not contacted at all and BMAD_SPRINT_STATUS is resolved
# inside this directory instead.
# BMAD_LOCAL_SOURCE=fixtures/sample-project
# BMAD_SPRINT_STATUS=_bmad-output/implementation-artifacts/sprint-12/sprint-status.yaml

# --- Hosting -----------------------------------------------------------------
# Set to false on any host that does not serve `/epics/41` from `epics/41.html`
# by itself. Vercel does (vercel.json sets cleanUrls); most other static hosts
# do not, and every internal link would 404 on first load.
# BMAD_CLEAN_URLS=false

# --- Optional tuning ---------------------------------------------------------
# BMAD_SITE_TITLE=Atlas Portal — Sprint 12
# BMAD_OUTPUT_DIR=.generated   # must stay inside this project
# BMAD_CONCURRENCY=6
# BMAD_MAX_LINKED_DOCUMENTS=40
# BMAD_MAX_ASSETS=60
# BMAD_MAX_ASSET_BYTES=5242880
# BMAD_LOG_LEVEL=info
